---
import config from "../content/config/config.json";
import IconLink from "./react/IconLink";
const today = new Date();
---

<footer class="site-footer">
	<nav aria-label="Footer navigation" class="footer-nav">
		{
			config.nav.map((nav) => (
				<a href={nav.link} class="footer-link">{nav.title}</a>
			))
		}
		<a href="/rss.xml" class="rss-link" title="Subscribe to RSS feed" aria-label="Subscribe to RSS feed" target="_blank" rel="noopener noreferrer">
			<svg class="rss-icon" viewBox="0 0 16 16" aria-hidden="true">
				<circle cx="3" cy="13" r="2"/>
				<path d="M15,15h-2.7C12.3,8.8,7.2,3.7,1,3.7V1C8.7,1,15,7.3,15,15z"/>
				<path d="M10.3,15H7.7c0-3.7-3-6.7-6.7-6.7V5.7C6.1,5.7,10.3,9.9,10.3,15z"/>
			</svg>
			<span class="sr-only">RSS</span>
		</a>
	</nav>
	
	<div class="footer-personal">
		<img 
			src="/avatar.svg" 
			alt={`Illustration of ${config.seo.siteOwner}`} 
			width="150" 
			height="150"
			class="footer-avatar"
			onerror="this.style.display='none'"
		/>
		<p class="footer-bio">
			Built with Astro + TinaCMS. Sharing thoughts on web dev, design, and whatever catches my curiosity.
		</p>
	</div>
</footer>

<style>
	.site-footer {
		background: rgb(var(--gray-light));
		padding: 1rem 1rem 0;
		position: sticky;
		bottom: 0;
		width: 100%;
		z-index: 10;
		display: grid;
		place-items: center;
	}
	.dark .site-footer {
		background: rgb(var(--gray-dark));
	}
	.footer-nav {
		display: flex;
		justify-content: center;
		gap: 1rem;
		margin-bottom: 1rem;
		flex-wrap: wrap;
	}
	.footer-link {
		color: rgb(var(--gray-dark));
		text-decoration: none;
		font-size: 0.875rem;
		font-weight: 500;
		transition: color 0.15s;
		padding: 0.25rem 0.5rem;
		border-radius: 4px;
	}
	.dark .footer-link {
		color: rgb(var(--gray-light));
	}
	.footer-link:hover {
		color: var(--accent);
	}
	@media (hover: hover) {
		.footer-link:hover {
			transform: scale(1.05);
		}
	}
	.rss-link {
		color: var(--accent);
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		font-size: 0.875rem;
		font-weight: 500;
		text-decoration: none;
		transition: color 0.15s;
		padding: 0.25rem 0.5rem;
		border-radius: 4px;
	}
	.rss-link:hover {
		color: var(--accent-dark);
	}
	.rss-icon {
		width: 16px;
		height: 16px;
		fill: currentColor;
	}
	.footer-personal {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding-bottom: 1rem;
	}
	.footer-avatar {
		width: 80px;
		height: 80px;
		border-radius: 50%;
		background: rgb(var(--gray));
		flex-shrink: 0;
	}
	.footer-bio {
		color: rgb(var(--gray));
		font-size: 0.875rem;
		max-width: 280px;
		margin: 0;
		text-align: left;
		line-height: 1.5;
	}
	.dark .footer-bio {
		color: rgb(var(--gray-light));
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
	
	/* Desktop: side-by-side layout like dandenney.com */
	@media (min-width: 768px) {
		.site-footer {
			align-items: center;
			display: flex;
			justify-content: center;
			gap: 2rem;
			padding: 1rem;
		}
		.footer-nav {
			margin-bottom: 0;
		}
		.footer-personal {
			padding-bottom: 0;
		}
	}
</style>
