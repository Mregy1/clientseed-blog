---
// TableOfContents.astro
// Renders an empty shell — JS populates it after AdminBlogPost (client:tina)
// finishes React hydration, detected via MutationObserver.
---

<nav class="toc" id="toc" aria-label="Table of contents" style="display:none">
  <p class="toc-title">Contents</p>
  <ol class="toc-list" id="toc-list"></ol>
</nav>

<script>
  function buildToc() {
    const nav  = document.getElementById('toc');
    const list = document.getElementById('toc-list');
    if (!nav || !list) return;

    // Clear any previous entries (handles Astro client-side navigation)
    list.innerHTML = '';

    const post     = document.querySelector('[data-post-body]');
    const headings = Array.from(post?.querySelectorAll('h2, h3') ?? []);

    if (headings.length < 2) {
      nav.style.display = 'none';
      return;
    }

    nav.style.display = '';

    headings.forEach((heading, i) => {
      // Auto-assign IDs to headings that don't have one
      if (!heading.id) {
        heading.id = `h-${i}-${(heading.textContent ?? '')
          .trim().toLowerCase()
          .replace(/\s+/g, '-')
          .replace(/[^a-z0-9-]/g, '')}`;
      }

      const li  = document.createElement('li');
      li.className = heading.tagName === 'H3' ? 'toc-sub' : '';

      const a   = document.createElement('a');
      a.href        = `#${heading.id}`;
      a.textContent = heading.textContent ?? '';
      a.addEventListener('click', (e) => {
        e.preventDefault();
        heading.scrollIntoView({ behavior: 'smooth', block: 'start' });
        history.pushState(null, '', `#${heading.id}`);
      });

      li.appendChild(a);
      list.appendChild(li);
    });

    // Highlight active section while scrolling
    const scrollObs = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          list.querySelectorAll('a').forEach(a => a.classList.remove('active'));
          list.querySelector(`a[href="#${entry.target.id}"]`)?.classList.add('active');
        }
      });
    }, { rootMargin: '-20% 0% -70% 0%' });

    headings.forEach(h => scrollObs.observe(h));
  }

  function waitForBodyAndBuild() {
    // FIX: AdminBlogPost uses client:tina — it hydrates after astro:page-load.
    // Use MutationObserver to detect when [data-post-body] appears in the DOM.
    const existing = document.querySelector('[data-post-body]');
    if (existing) {
      buildToc();
      return;
    }

    const mutObs = new MutationObserver(() => {
      if (document.querySelector('[data-post-body]')) {
        mutObs.disconnect();
        buildToc();
      }
    });
    mutObs.observe(document.body, { childList: true, subtree: true });
  }

  // astro:page-load fires on initial load AND after client-side navigation
  document.addEventListener('astro:page-load', waitForBodyAndBuild);
</script>

<style>
  .toc {
    background: rgba(var(--gray-light), 0.4);
    border: 1px solid rgb(var(--gray-light));
    border-radius: 8px;
    padding: 1rem 1.25rem;
    margin-bottom: 2rem;
    font-size: 0.9rem;
  }
  .toc-title {
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgb(var(--gray));
    margin: 0 0 0.5rem;
  }
  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .toc-list a {
    color: rgb(var(--gray-dark));
    text-decoration: none;
    display: block;
    padding: 2px 0;
    transition: color 0.15s;
  }
  .toc-list a:hover,
  .toc-list a.active { color: var(--accent); }
  .toc-sub a {
    padding-left: 1rem;
    font-size: 0.85rem;
    color: rgb(var(--gray));
  }
  .toc-sub a:hover,
  .toc-sub a.active { color: var(--accent); }
</style>
