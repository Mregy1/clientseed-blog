---
// src/pages/search.astro
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import config from '../content/config/config.json';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Search — ${config.seo.title}`} description="Search all posts" />
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  </head>
  <body>
    <Header />
    <main>
      <h1 class="search-heading">Search</h1>
      <div id="search" aria-label="Search posts"></div>
    </main>
    <Footer />

    <!-- FIX: dynamic import ensures pagefind-ui.js is fully loaded before init -->
    <script>
      (async () => {
        await import('/pagefind/pagefind-ui.js');
        new (window as any).PagefindUI({
          element: '#search',
          showImages: true,
          showEmptyFilters: false,
          resetStyles: false,
        });
      })();
    </script>
  </body>
</html>

<style>
  main {
    max-width: 672px;
    margin-inline: auto;
    padding: 2rem 1.5rem 4rem;
  }
  .search-heading {
    font-size: 2rem;
    margin-bottom: 1.5rem;
  }
  :root {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: rgb(var(--gray-dark));
    --pagefind-ui-background: #fff;
    --pagefind-ui-border: rgb(var(--gray-light));
    --pagefind-ui-border-radius: 8px;
    --pagefind-ui-font: 'Atkinson', sans-serif;
  }
</style>
