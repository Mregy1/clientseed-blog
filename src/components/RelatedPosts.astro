---
// RelatedPosts.astro
// Usage: <RelatedPosts posts={relatedPostsArray} />
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
  posts: CollectionEntry<'blog'>[];
}
const { posts } = Astro.props;
---

<aside class="related-posts" aria-label="Related posts">
  <h2 class="related-title">Related posts</h2>
  <div class="related-grid">
    {posts.map(post => (
      <a href={`/blog/${post.id}/`} class="related-card">
        {post.data.heroImage && (
          <img
            src={post.data.heroImage}
            alt={`Cover image for ${post.data.title}`}
            width="400"
            height="267"
            loading="lazy"
          />
        )}
        <div class="related-info">
          <p class="related-date">
            <FormattedDate date={post.data.pubDate} />
          </p>
          <h3 class="related-post-title">{post.data.title}</h3>
          {post.data.description && (
            <p class="related-desc">{post.data.description}</p>
          )}
        </div>
      </a>
    ))}
  </div>
</aside>

<style>
  .related-posts {
    max-width: 672px;
    margin-inline: auto;
    padding: 2rem 1.5rem 3rem;
    border-top: 1px solid rgb(var(--gray-light));
  }

  .related-title {
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgb(var(--gray));
    margin: 0 0 1.25rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .related-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border: 1px solid rgb(var(--gray-light));
    border-radius: 10px;
    overflow: hidden;
    transition: box-shadow 0.2s, border-color 0.2s;
  }

  .related-card:hover {
    border-color: rgb(var(--gray));
    box-shadow: var(--box-shadow);
  }

  .related-card img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    display: block;
    border-radius: 0;
    margin: 0;
  }

  .related-info {
    padding: 0.85rem 1rem;
    flex: 1;
  }

  .related-date {
    font-size: 0.78rem;
    color: rgb(var(--gray));
    margin: 0 0 0.3rem;
  }

  .related-post-title {
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 0.4rem;
    color: rgb(var(--black));
  }

  .related-desc {
    font-size: 0.82rem;
    color: rgb(var(--gray));
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 600px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
    .related-posts {
      padding-inline: 1rem;
    }
  }
</style>
