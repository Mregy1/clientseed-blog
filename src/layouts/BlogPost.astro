---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';

const { data } = Astro.props;
const blog = data?.blog;

const title       = blog?.title       ?? '';
const description = blog?.description ?? '';
const heroImage   = blog?.heroImage   ?? undefined;
const pubDate     = blog?.pubDate     ? new Date(blog.pubDate)     : undefined;
const updatedDate = blog?.updatedDate ? new Date(blog.updatedDate) : undefined;

const allPosts = await getCollection('blog');
const related = allPosts
  .filter(p => p.id !== Astro.params.slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
---

<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={heroImage}
      pubDate={pubDate}
      updatedDate={updatedDate}
      type="article"
    />
  </head>

  <body>
    <div id="reading-progress" aria-hidden="true"></div>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header />

    <main id="main-content">
      <!-- .post-article-wrapper is the relative container for sidebar TOC positioning -->
      <div class="post-article-wrapper">
        <article class="post-article" aria-label={title}>

          <!-- AdminBlogPost renders: hero, date+readingTime, h1, hr, body, TOC -->
          <slot />

          <!-- Breadcrumb navigation at end of post -->
          <Breadcrumb postTitle={title} />

        </article>

        {related.length > 0 && <RelatedPosts posts={related} />}
      </div>
    </main>

    <Footer />

    <script is:inline>
      // Reading progress bar — runs immediately, no module bundling needed
      (function () {
        var bar = document.getElementById('reading-progress');
        function update() {
          var article = document.querySelector('.post-article');
          if (!article || !bar) return;
          var rect = article.getBoundingClientRect();
          var scrolled = window.innerHeight - rect.top;
          var total = rect.height;
          var pct = Math.min(100, Math.max(0, (scrolled / total) * 100));
          bar.style.width = pct + '%';
        }
        window.addEventListener('scroll', update, { passive: true });
        update();
      })();
    </script>
    <script>
      import mediumZoom from 'medium-zoom';
      function initZoom() {
        mediumZoom('.prose [data-post-body] img', {
          margin: 24,
          background: 'rgba(0, 0, 0, 0.85)',
        });
      }
      const target = document.querySelector('[data-post-body]');
      if (target) {
        initZoom();
      } else {
        const obs = new MutationObserver(() => {
          if (document.querySelector('[data-post-body]')) {
            obs.disconnect();
            initZoom();
          }
        });
        obs.observe(document.body, { childList: true, subtree: true });
      }
    </script>
  </body>
</html>

<style>
  /* ── Reading progress bar ───────────────────────────── */
  :global(#reading-progress) {
    position: fixed;
    top: 0;
    left: 0;
    width: 0%;
    height: 3px;
    background: var(--accent);
    z-index: 9999;
    transition: width 0.05s linear;
    border-radius: 0 2px 2px 0;
    box-shadow: 0 0 6px rgba(35, 55, 255, 0.4);
  }

  /* ── Skip link ──────────────────────────────────────── */
  :global(.skip-link) {
    position: absolute;
    top: -100px;
    left: 1rem;
    background: var(--accent);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 0 0 6px 6px;
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    z-index: 9999;
    transition: top 0.2s;
  }
  :global(.skip-link:focus) { top: 0; }

  /* ── Outer wrapper — wide enough to hold article + TOC side by side */
  .post-article-wrapper {
    position: relative;
    /* 768px article + 2×240px TOC gutters = 1248px total */
    max-width: 1248px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* ── Article column — matches cloned site max-w-3xl (768px) ── */
  .post-article {
    max-width: 768px;
    margin-inline: auto;
    padding: 2.5rem 0 5rem;
  }

  /* ── Hero image — full viewport width ───────────────── */
  .post-article :global(.hero-image) {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
    margin-bottom: 2.5rem;
  }
  .post-article :global(.hero-image img) {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 0;
  }

  /* ── Date + reading time row ── */
  :global(.post-meta-bar) {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.875rem;
    color: rgb(var(--gray));
    margin-bottom: 0.75rem;
    font-family: 'Montserrat', sans-serif;
  }
  :global(.updated-notice) {
    font-size: 0.875rem;
    font-style: italic;
    color: rgb(var(--gray));
    margin: 0.25rem 0 0;
  }

  /* ── Post title — Montserrat black, tight tracking ───── */
  .post-article :global(.prose .title) {
    text-align: left;
    padding: 0;
    margin-bottom: 2rem;
  }
  .post-article :global(.prose .title h1) {
    font-family: 'Montserrat', sans-serif;
    font-weight: 900;
    font-size: 2.6rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0.25rem 0 0.5rem;
    color: rgb(var(--black));
  }

  /* ── Body prose — Lora serif, generous size ─────────── */
  .post-article :global(.prose) {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0;
    /* Lora = the serif font from Google Fonts we loaded */
    font-family: 'Lora', Georgia, serif;
    font-size: 1.2rem;        /* ~19px — "zoomed in" reading feel */
    line-height: 1.85;
    color: rgb(var(--gray-dark));
  }
  .post-article :global(.prose p) {
    margin-bottom: 1.75em;
  }

  /* ── In-body headings — Montserrat, left-aligned ────── */
  .post-article :global(.prose h2),
  .post-article :global([data-post-body] h2) {
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    font-size: 1.6rem;
    letter-spacing: -0.01em;
    margin-top: 3rem;
    margin-bottom: 0.75rem;
    color: rgb(var(--black));
  }
  .post-article :global(.prose h3),
  .post-article :global([data-post-body] h3) {
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    font-size: 1.25rem;
    margin-top: 2.25rem;
    margin-bottom: 0.5rem;
    color: rgb(var(--black));
  }

  /* ── Body images ─────────────────────────────────────── */
  .post-article :global([data-post-body] img) {
    cursor: zoom-in;
    border-radius: 8px;
    transition: transform 0.2s ease;
    max-width: 100%;
    height: auto;
    display: block;
    margin: 2.5rem 0;
  }
  .post-article :global([data-post-body] img:hover) {
    transform: scale(1.02);
  }

  /* ── medium-zoom overlay ──────────────────────────────── */
  :global(.medium-zoom-overlay)       { z-index: 1000; }
  :global(.medium-zoom-image--opened) { z-index: 1001; }

  /* ── Focus styles ────────────────────────────────────── */
  :global(a:focus-visible),
  :global(button:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 3px;
  }

  @media (max-width: 720px) {
    .post-article-wrapper { padding: 0 1.25rem; }
    .post-article { padding: 1.5rem 0 3rem; }
    .post-article :global(.hero-image) {
      width: 100vw;
      margin-left: calc(-50vw + 50%);
      margin-right: calc(-50vw + 50%);
    }
    .post-article :global(.prose .title h1) {
      font-size: 2rem;
    }
    .post-article :global(.prose) { font-size: 1.05rem; }
  }
</style>