---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import { getCollection } from 'astro:content';

const { data } = Astro.props;
const blog = data?.blog;

const title       = blog?.title       ?? '';
const description = blog?.description ?? '';
const heroImage   = blog?.heroImage   ?? undefined;
const pubDate     = blog?.pubDate     ? new Date(blog.pubDate)     : undefined;
const updatedDate = blog?.updatedDate ? new Date(blog.updatedDate) : undefined;

const allPosts = await getCollection('blog');
const related = allPosts
  .filter(p => p.id !== Astro.params.slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
---

<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={heroImage}
      pubDate={pubDate}
      updatedDate={updatedDate}
      type="article"
    />
  </head>

  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header />

    <main id="main-content">
      <!-- .post-article-wrapper is the relative container for sidebar TOC positioning -->
      <div class="post-article-wrapper">
        <article class="post-article" aria-label={title}>

          <!-- AdminBlogPost renders: hero, date+readingTime, h1, hr, body, TOC -->
          <slot />

        </article>

        {related.length > 0 && <RelatedPosts posts={related} />}
      </div>
    </main>

    <Footer />

    <script>
      import mediumZoom from 'medium-zoom';
      function initZoom() {
        mediumZoom('.prose [data-post-body] img', {
          margin: 24,
          background: 'rgba(0, 0, 0, 0.85)',
        });
      }
      const target = document.querySelector('[data-post-body]');
      if (target) {
        initZoom();
      } else {
        const obs = new MutationObserver(() => {
          if (document.querySelector('[data-post-body]')) {
            obs.disconnect();
            initZoom();
          }
        });
        obs.observe(document.body, { childList: true, subtree: true });
      }
    </script>
  </body>
</html>

<style>
  /* ── Skip link ──────────────────────────────────────── */
  :global(.skip-link) {
    position: absolute;
    top: -100px;
    left: 1rem;
    background: var(--accent);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 0 0 6px 6px;
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    z-index: 9999;
    transition: top 0.2s;
  }
  :global(.skip-link:focus) { top: 0; }

  /* ── Wrapper: relative container for TOC sidebar positioning */
  .post-article-wrapper {
    position: relative;
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* ── Article column — centered, 680px ──────────────── */
  .post-article {
    max-width: 680px;
    margin-inline: auto;
    padding: 2rem 0 4rem;
  }

  /* ── Hero image — full viewport width, no radius ───── */
  .post-article :global(.hero-image) {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
    margin-bottom: 2rem;
  }
  .post-article :global(.hero-image img) {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 0;
  }

  /* ── TOC sidebar positioning handled by global.css ── */

  /* ── Date + reading time row ── */
  :global(.post-meta-bar) {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.875rem;
    color: rgb(var(--gray));
    margin-bottom: 0.5rem;
  }
  :global(.updated-notice) {
    font-size: 0.875rem;
    font-style: italic;
    color: rgb(var(--gray));
    margin: 0.25rem 0 0;
  }

  /* ── Title block ─────────────────────────────────────── */
  .post-article :global(.prose .title) {
    text-align: left;
    padding: 0;
    margin-bottom: 2rem;
  }
  .post-article :global(.prose .title h1) {
    font-size: 2.2rem;
    line-height: 1.2;
    margin: 0.25rem 0 0.5rem;
  }

  /* ── Body prose ─────────────────────────────────────── */
  .post-article :global(.prose) {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0;
    font-size: 1.125rem;
    line-height: 1.8;
    color: rgb(var(--gray-dark));
  }
  .post-article :global(.prose p)  { margin-bottom: 1.6em; }
  .post-article :global(.prose h2) { font-size: 1.6rem; margin-top: 2.5rem; margin-bottom: 0.75rem; }
  .post-article :global(.prose h3) { font-size: 1.3rem; margin-top: 2rem;   margin-bottom: 0.5rem;  }

  /* ── Body images ─────────────────────────────────────── */
  .post-article :global([data-post-body] img) {
    cursor: zoom-in;
    border-radius: 8px;
    transition: filter 0.2s ease;
    max-width: 100%;
    height: auto;
    display: block;
    margin: 2rem 0;
  }
  .post-article :global([data-post-body] img:hover) { filter: brightness(0.87); }

  /* ── medium-zoom overlay ──────────────────────────────── */
  :global(.medium-zoom-overlay)       { z-index: 1000; }
  :global(.medium-zoom-image--opened) { z-index: 1001; }

  /* ── Focus styles ────────────────────────────────────── */
  :global(a:focus-visible),
  :global(button:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 3px;
  }

  @media (max-width: 720px) {
    .post-article { padding: 1.5rem 0 3rem; }
    .post-article :global(.hero-image) {
      width: 100vw;
      margin-left: calc(-50vw + 50%);
      margin-right: calc(-50vw + 50%);
    }
    .post-article :global(.prose .title h1) { font-size: 1.8rem; }
    .post-article :global(.prose) { font-size: 1rem; }
  }
</style>