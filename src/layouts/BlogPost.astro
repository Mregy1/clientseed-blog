---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import TableOfContents from '../components/react/TableOfContents';
import { getCollection } from 'astro:content';

const { data } = Astro.props;
const blog = data?.blog;

const title       = blog?.title       ?? '';
const description = blog?.description ?? '';
const heroImage   = blog?.heroImage   ?? undefined;
const pubDate     = blog?.pubDate     ? new Date(blog.pubDate)     : undefined;
const updatedDate = blog?.updatedDate ? new Date(blog.updatedDate) : undefined;

const allPosts = await getCollection('blog');
const related = allPosts
  .filter(p => p.id !== Astro.params.slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
---

<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={heroImage}
      pubDate={pubDate}
      updatedDate={updatedDate}
      type="article"
    />
  </head>

  <body>
    <div id="reading-progress" aria-hidden="true"></div>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header />

    <main id="main-content" class="main-content">
      <article class="post-article toc-scope" aria-label={title}>
        
        <!-- HERO HEADER: Title over image (dandenney style) -->
        <header class="post-hero">
          <img 
            class="hero-image" 
            src={heroImage} 
            alt="" 
            loading="eager"
            decoding="async"
          />
          <div class="hero-overlay"></div>
          
          <div class="hero-content">
            <div class="post-meta-bar">
              {pubDate && (
                <span class="post-date">
                  {pubDate.toLocaleDateString('en-us', { year: 'numeric', month: 'short', day: 'numeric' })}
                </span>
              )}
              {updatedDate && (
                <span class="updated-notice">Updated: {updatedDate.toLocaleDateString('en-us', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
              )}
            </div>
            <h1 class="post-title">{title}</h1>
          </div>
        </header>

        <!-- ARTICLE BODY -->
        <div class="post-body-wrapper">
          <!-- TOC Sidebar — TableOfContents React component mounts here -->
          <div class="toc-sidebar" id="toc-sidebar">
            <TableOfContents client:load />
          </div>

          <!-- Main Content -->
          <div class="post-content">
            <!-- Reading time + metadata -->
            <div class="reading-time-bar">
              <span class="reading-time-badge">
                <svg class="clock-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/>
                  <polyline points="12 6 12 12 16 14"/>
                </svg>
                <span id="reading-time"></span>
              </span>
            </div>

            <!-- TinaCMS content renders here -->
            <div class="prose-content" data-post-body>
              <slot />
            </div>

            <!-- Breadcrumb at bottom -->
            <Breadcrumb postTitle={title} />
          </div>
        </div>

        <!-- Related Posts -->
        {related.length > 0 && <RelatedPosts posts={related} />}

      </article>
    </main>

    <Footer />

    <!-- Reading progress bar -->
    <script is:inline>
      (function () {
        var bar = document.getElementById('reading-progress');
        function update() {
          var article = document.querySelector('.post-article');
          if (!article || !bar) return;
          var rect = article.getBoundingClientRect();
          var scrolled = window.innerHeight - rect.top;
          var total = rect.height;
          var pct = Math.min(100, Math.max(0, (scrolled / total) * 100));
          bar.style.width = pct + '%';
        }
        window.addEventListener('scroll', update, { passive: true });
        update();
      })();
    </script>

    <!-- Reading time calculation -->
    <script is:inline>
      (function() {
        var postBody = document.querySelector('[data-post-body]');
        if (!postBody) return;
        var text = postBody.textContent || '';
        var words = text.trim().split(/\s+/).length;
        var minutes = Math.ceil(words / 200);
        var badge = document.getElementById('reading-time');
        if (badge) {
          badge.textContent = minutes + ' min read';
        }
      })();
    </script>

    <!-- Medium zoom for images -->
    <script>
      import mediumZoom from 'medium-zoom';
      function initZoom() {
        mediumZoom('[data-post-body] img', {
          margin: 24,
          background: 'rgba(0, 0, 0, 0.85)',
        });
      }
      if (document.querySelector('[data-post-body]')) {
        initZoom();
      }
    </script>
  </body>
</html>

<style>
  /* ── Main Content Area ─────────────────────────────── */
  .main-content {
    background: white;
    position: relative;
    z-index: 10;
  }
  .dark .main-content {
    background: rgb(15, 23, 42); /* slate-900 */
    color: rgb(226, 232, 240); /* slate-200 */
  }

  /* ── Reading progress bar ───────────────────────────── */
  :global(#reading-progress) {
    position: fixed;
    top: 0;
    left: 0;
    width: 0%;
    height: 3px;
    background: var(--accent);
    z-index: 9999;
    transition: width 0.05s linear;
    border-radius: 0 2px 2px 0;
    box-shadow: 0 0 6px rgba(35, 55, 255, 0.4);
  }

  /* ── Skip link ──────────────────────────────────────── */
  :global(.skip-link) {
    position: absolute;
    top: -100px;
    left: 1rem;
    background: var(--accent);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 0 0 6px 6px;
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    z-index: 9999;
    transition: top 0.2s;
  }
  :global(.skip-link:focus) { top: 0; }

  /* ── Post Article ───────────────────────────────────── */
  .post-article {
    width: 100%;
    max-width: 100%;
  }

  /* ── Hero Header (dandenney style: title over image) ─ */
  .post-hero {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 2;
    max-height: 600px;
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(var(--black), 0.6);
    z-index: 1;
    transition: opacity 0.3s;
  }
  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 2rem;
    max-width: 900px;
    margin: 0 auto;
  }
  .post-title {
    font-family: 'Montserrat', sans-serif;
    font-weight: 900;
    font-size: 2.6rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: white;
    margin: 0.5rem 0 0;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
  }
  .post-meta-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 1rem;
    font-family: 'Montserrat', sans-serif;
  }
  .post-date {
    font-weight: 500;
  }
  .updated-notice {
    font-style: italic;
    opacity: 0.8;
  }

  /* ── Body Layout ───────────────────────────────────── */
  .post-body-wrapper {
    position: relative;
    max-width: 1248px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    gap: 2rem;
  }
  .post-content {
    flex: 1;
    max-width: 768px;
    margin: 0 auto;
    padding: 2.5rem 0 5rem;
  }

  /* ── TOC Sidebar ───────────────────────────────────── */
  .toc-sidebar {
    display: none;
  }
  @media (min-width: 1200px) {
    .toc-sidebar {
      display: block;
      width: 220px;
      flex-shrink: 0;
      position: relative;
    }
  }

  /* ── Reading Time ──────────────────────────────────── */
  .reading-time-bar {
    margin-bottom: 1.5rem;
  }
  .reading-time-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: rgb(var(--gray));
    font-family: 'Montserrat', sans-serif;
  }
  .dark .reading-time-badge {
    color: rgb(var(--gray-light));
  }
  .clock-icon {
    width: 16px;
    height: 16px;
  }

  /* ── Prose Content (System Sans — dandenney style) ─── */
  .prose-content {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0;
    /* System sans for that dandenney zoom-in feel */
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    font-size: 1.125rem;
    line-height: 1.7;
    color: rgb(var(--gray-dark));
  }
  .dark .prose-content {
    color: rgb(226, 232, 240);
  }
  .prose-content :global(p) {
    margin-bottom: 1.5em;
  }
  .prose-content :global(h2) {
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    font-size: 1.6rem;
    letter-spacing: -0.01em;
    margin-top: 3rem;
    margin-bottom: 0.75rem;
    color: rgb(var(--black));
  }
  .dark .prose-content :global(h2) {
    color: white;
  }
  .prose-content :global(h3) {
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    font-size: 1.25rem;
    margin-top: 2.25rem;
    margin-bottom: 0.5rem;
    color: rgb(var(--black));
  }
  .dark .prose-content :global(h3) {
    color: white;
  }
  .prose-content :global(a) {
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.15s;
  }
  .prose-content :global(a:hover) {
    color: var(--accent-dark);
    text-decoration: underline;
  }
  .prose-content :global(blockquote) {
    border-left: 4px solid var(--accent);
    padding: 0 0 0 20px;
    margin: 2rem 0;
    font-size: 1.125rem;
    font-style: italic;
    color: rgb(var(--gray));
  }
  .dark .prose-content :global(blockquote) {
    color: rgb(var(--gray-light));
  }
  .prose-content :global(pre) {
    padding: 1.5em;
    border-radius: 8px;
    background: rgb(var(--gray-dark));
    overflow-x: auto;
  }
  .dark .prose-content :global(pre) {
    background: rgb(30, 41, 59);
  }
  .prose-content :global(code) {
    padding: 2px 6px;
    background: rgb(var(--gray-light));
    border-radius: 4px;
    font-size: 0.875em;
  }
  .dark .prose-content :global(code) {
    background: rgb(51, 65, 85);
    color: rgb(226, 232, 240);
  }
  .prose-content :global(pre > code) {
    background: none;
    padding: 0;
    color: rgb(var(--gray-light));
  }
  .prose-content :global(ul),
  .prose-content :global(ol) {
    margin-bottom: 1.5em;
    padding-left: 1.5em;
  }
  .prose-content :global(li) {
    margin-bottom: 0.5em;
  }
  .prose-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 2rem 0;
    display: block;
  }
  .prose-content :global(figure) {
    margin: 2rem 0;
  }
  .prose-content :global(figcaption) {
    font-size: 0.875rem;
    color: rgb(var(--gray));
    text-align: center;
    margin-top: 0.5rem;
  }
  .prose-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
  }
  .prose-content :global(th),
  .prose-content :global(td) {
    padding: 0.75rem;
    border-bottom: 1px solid rgb(var(--gray-light));
    text-align: left;
  }
  .prose-content :global(th) {
    font-weight: 700;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgb(var(--gray));
  }
  .prose-content :global(hr) {
    border: none;
    border-top: 1px solid rgb(var(--gray-light));
    margin: 2.5rem 0;
  }

  /* ── Medium Zoom ───────────────────────────────────── */
  :global(.medium-zoom-overlay) {
    z-index: 1000;
  }
  :global(.medium-zoom-image--opened) {
    z-index: 1001;
  }

  /* ── Focus Styles ──────────────────────────────────── */
  :global(a:focus-visible),
  :global(button:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 3px;
  }

  /* ── Responsive ─────────────────────────────────────── */
  @media (max-width: 720px) {
    .post-hero {
      aspect-ratio: 4 / 3;
      max-height: 400px;
    }
    .post-title {
      font-size: 1.8rem;
    }
    .post-body-wrapper {
      padding: 0 1.25rem;
    }
    .post-content {
      padding: 1.5rem 0 3rem;
    }
    .prose-content {
      font-size: 1rem;
    }
  }

  /* ── TOC scope for scroll-driven animations (future) ─ */
  .toc-scope {
    /* CSS scroll-timeline will be added here when supported */
  }
</style>
